{
  "expo": {
    "name": "ReadSearch",
    "slug": "readsearch",
    "backgroundColor": "#050d24",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#050d24",
      "resizeMode": "contain"
    },
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ],
    "android": {
      "package": "com.readgreat.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#050d24"
      }
    },
    "ios": {
      "bundleIdentifier": "com.readgreat.app"
    },
    "icon": "./assets/icon.png"
  }
}